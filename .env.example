DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=<nama-database>
DB_USER=<nama-user>
DB_PASS=<password-user>
PORT=3000
NODE_ENV=development

# Security & JWT Configuration
# Di production, ganti JWT_SECRET dengan string acak dan panjang (minimal 32 karakter)
JWT_SECRET=your-development-secret
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS Configuration
# Di production, batasi ke domain spesifik
CORS_ORIGIN=http://localhost:3000

